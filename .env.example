# Copy this file to .env and fill in the values
# cp .env.example .env

# ---------------------------------------------------------------------------
# Database — when running via docker-compose.dev.yml these values are fixed.
# TYPEORM_HOST must match the service name in docker-compose.dev.yml ("postgres").
# ---------------------------------------------------------------------------
TYPEORM_CONNECTION=postgres
TYPEORM_HOST=postgres
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=docker
TYPEORM_DATABASE=zerobito

# ---------------------------------------------------------------------------
# JWT — any random string works for local dev.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# Email (SMTP) — for local dev use a free Mailtrap sandbox (https://mailtrap.io).
# Create a free account, open Inboxes > SMTP Settings and copy the credentials.
# ---------------------------------------------------------------------------
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=

# ---------------------------------------------------------------------------
# Frontend URL — used in emails sent by the backend (password reset links, etc.)
# ---------------------------------------------------------------------------
URL_APLICACAO_FRONTEND=http://localhost:3000
