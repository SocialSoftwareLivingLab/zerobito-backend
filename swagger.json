{
    "openapi": "3.1.0",
    "zerobito-backend": "0.0.1",
    "info": {
        "title": "Zerobito - Backend",
        "version": "0.0.1",
        "description": "Documentação do projeto ZerObito, sistema para mapear ocorrências e acidentes de trabalho do Ministério Público",
        "license": {
            "name": "Apache 2.0",
            "url": "https://www.apache.org/licenses/LICENSE-2.0"
        }
    },
    "defaultContentType": "application/json",
    "tags": [
        {
            "name": "Autenticacao",
            "description": "Operações relacionadas à autenticação de usuários"
        },
        {
            "name": "Usuarios",
            "description": "Realiza a gestão dos usuários da plataforma"
        },
        {
            "name": "Administracao",
            "description": "Endpoints e funcionalidades que só podem ser utilizadas por usuários administradores da plataforma"
        }
    ],
    "paths": {
        "/login": {
            "post": {
                "tags": [
                    "Autenticacao"
                ],
                "summary": "Efetua login de um usuário",
                "description": "Este endpoint autentica um usuário com base no email e senha fornecidos e retorna o nome do usuário, email e um token de acesso.",
                "requestBody": {
                    "description": "Dados de login do usuário",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login bem-sucedido",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Requisição inválida, dados de login ausentes ou incorretos."
                    },
                    "401": {
                        "$ref": "#/components/responses/ErroCredenciaisInvalidas"
                    }
                }
            }
        },
        "/register": {
            "post": {
                "tags": [
                    "Autenticacao"
                ],
                "summary": "Registra um novo usuário",
                "description": "Este endpoint registra um novo usuário com os dados fornecidos e retorna informações básicas sobre o usuário registrado.",
                "requestBody": {
                    "description": "Dados do usuário para registro",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CriarUsuarioRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuário registrado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CriarUsuarioResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Requisição inválida, dados de registro ausentes ou incorretos."
                    }
                }
            }
        },
        "/users": {
            "get": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Lista todos os usuários cadastrados",
                "description": "Este endpoint retorna uma lista de todos os usuários cadastrados, requerendo autenticação via token JWT.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de usuários obtida com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/UsuarioResponse"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/ErroNaoAutorizado"
                    }
                }
            }
        },
        "/users/{id}": {
            "delete": {
                "tags": [
                    "Usuarios",
                    "Administracao"
                ],
                "summary": "Exclui um usuário especificado",
                "description": "Este endpoint exclui um usuário com base no ID fornecido. Requer privilégios de administrador.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "ID único do usuário a ser excluído",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Usuário excluído com sucesso, sem conteúdo para retornar."
                    },
                    "403": {
                        "$ref": "#/components/responses/ErroNaoAutorizado"
                    }
                }
            },
            "put": {
                "tags": [
                    "Usuarios",
                    "Administracao"
                ],
                "summary": "Atualiza os dados de um usuário",
                "description": "Este endpoint atualiza os dados de um usuário especificado pelo ID, incluindo nome, email e senha. Requer privilégios de administrador.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "ID único do usuário a ser atualizado",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "description": "Dados do usuário para atualização",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AtualizarUsuarioRequest"
                            }
                        }
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Dados do usuário atualizados com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UsuarioResponse"
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/ForbiddenError"
                    }
                }
            }
        }
    },
    "components": {
        "responses": {
            "ErroCredenciaisInvalidas": {
                "description": "Credenciais inválidas.",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Mensagem de erro detalhando o problema ocorrido"
                                }
                            }
                        }
                    }
                }
            },
            "ErroNaoAutorizado": {
                "description": "Não autorizado, token JWT inválido ou não fornecido.",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Mensagem de erro detalhando o problema ocorrido"
                                }
                            }
                        }
                    }
                }
            },
            "ErroAcessoNegado": {
                "description": "Acesso negado, o usuário não tem permissão suficiente para executar esta ação.",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Mensagem de erro detalhando o problema ocorrido"
                                }
                            }
                        }
                    }
                }
            }
        },
        "securitySchemes": {
            "BearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "description": "Token JWT necessário para acessar endpoints protegidos."
            }
        },
        "schemas": {
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "description": "O email do usuário utilizado para fazer login."
                    },
                    "senha": {
                        "type": "string",
                        "description": "A senha do usuário utilizada para fazer login."
                    }
                },
                "required": [
                    "email",
                    "senha"
                ]
            },
            "LoginResponse": {
                "type": "object",
                "properties": {
                    "nome": {
                        "type": "string",
                        "description": "O nome completo do usuário."
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "description": "O email do usuário, igual ao fornecido na requisição de login."
                    },
                    "token": {
                        "type": "string",
                        "description": "Um token de autenticação que pode ser usado para acessar endpoints protegidos."
                    }
                }
            },
            "CriarUsuarioRequest": {
                "type": "object",
                "properties": {
                    "nome": {
                        "type": "string",
                        "description": "O nome completo do usuário a ser registrado."
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "description": "O email do usuário a ser registrado."
                    },
                    "senha": {
                        "type": "string",
                        "description": "A senha escolhida pelo usuário para registro."
                    },
                    "role": {
                        "type": "string",
                        "description": "O papel do usuário dentro do sistema (ex: USER, ADMIN).",
                        "example": "USER"
                    }
                },
                "required": [
                    "nome",
                    "email",
                    "senha",
                    "role"
                ]
            },
            "CriarUsuarioResponse": {
                "type": "object",
                "properties": {
                    "nome": {
                        "type": "string",
                        "description": "O nome completo do usuário registrado."
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "description": "O email do usuário registrado."
                    },
                    "role": {
                        "type": "string",
                        "description": "O papel do usuário dentro do sistema confirmado após o registro."
                    }
                }
            },
            "UsuarioResponse": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Identificador único do usuário."
                    },
                    "nome": {
                        "type": "string",
                        "description": "O nome completo do usuário."
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "description": "O email do usuário."
                    },
                    "senha": {
                        "type": "string",
                        "description": "A senha do usuário (criptografada)."
                    },
                    "role": {
                        "type": "string",
                        "description": "O papel do usuário dentro do sistema."
                    }
                }
            },
            "AtualizarUsuarioRequest": {
                "type": "object",
                "properties": {
                    "nome": {
                        "type": "string",
                        "description": "O novo nome completo do usuário."
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "description": "O novo email do usuário."
                    },
                    "senha": {
                        "type": "string",
                        "description": "A nova senha do usuário."
                    }
                },
                "required": [
                    "nome",
                    "email",
                    "senha"
                ]
            }
        }
    }
}